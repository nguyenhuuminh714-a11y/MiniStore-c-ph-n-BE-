

@using System.Web.Mvc
@using System.Web.Mvc.Html
@inherits System.Web.Mvc.WebViewPage<MiniStore.Models.Order>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewBag.Title = "Chi tiết đơn hàng";
}

<div class="card shadow-sm">
    <div class="card-body">

        <h2 class="mb-4">CHI TIẾT ĐƠN HÀNG</h2>

        <h5>Mã đơn hàng: #@Model.OrderID</h5>

        <p>
            <strong>Ngày đặt:</strong>
            @Model.OrderDate.ToString("dd/MM/yyyy")
        </p>

        <p>
            <strong>Trạng thái:</strong>
            <span class="text-primary">
                @Model.PaymentStatus
            </span>
        </p>

        <p>
            <strong>Địa chỉ giao hàng:</strong>
            @Model.AddressDelivery
        </p>

        <p>
            <strong>Phương thức giao hàng:</strong>
            @Model.DeliveryMethod
        </p>

        <p>
            <strong>Phương thức thanh toán:</strong>
            @Model.PaymentMethod
        </p>

        <hr />

        <h5>Sản phẩm đã đặt</h5>

        <table class="table table-bordered">
            <thead class="thead-light">
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td>@item.Product.ProductName</td>

                        <td>
                            @item.UnitPrice.ToString("N0") đ
                        </td>

                        <td>@item.Quantity</td>

                        <td>
                            @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h4 class="text-danger text-right">
            Tổng tiền: @Model.TotalAmount.ToString("N0") đ
        </h4>

        <div class="mt-3">
            <a href="@Url.Action("MyOrder", "Order")"
               class="btn btn-secondary">
                Quay lại đơn hàng
            </a>
        </div>

    </div>
</div>



